root = "."
tmp_dir = "tmp"

[build]
  entrypoint = "./cmd/server"
  cmd = "dlv debug --headless --api-version=2 --listen=:2345 --accept-multiclient --continue ./cmd/server"
  bin = "./tmp/server"
  include_ext = ["go", "tpl", "tmpl", "html"]
  exclude_dir = ["tmp", "vendor", "node_modules"]
  exclude_regex = ["_test.go"]
  delay = 1000
  stop_on_error = true
  send_interrupt = true
  kill_delay = "1s"

[log]
  time = true

[misc]
  clean_on_exit = true